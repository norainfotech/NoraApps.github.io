{
  "hosting": [
    {
      "site": "noraapps",
      "public": "portal",
      "ignore": [
        "**/.*"
      ],
      "redirects": [
        {
          "source": "/yz101/**",
          "destination": "https://aikocu.norainfotech.com/",
          "type": 301
        },
        {
          "source": "/yz101",
          "destination": "https://aikocu.norainfotech.com/",
          "type": 301
        },
        {
          "source": "/aikocu/**",
          "destination": "https://aikocu.norainfotech.com/",
          "type": 301
        },
        {
          "source": "/aikocu",
          "destination": "https://aikocu.norainfotech.com/",
          "type": 301
        }
      ]
    },
    {
      "site": "yz101app",
      "public": "portal/aikocu",
      "ignore": [
        "**/.*"
      ],
      "redirects": [
        {
          "source": "/yz101/**",
          "destination": "/",
          "type": 302
        }
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        }
      ]
    },
    {
      "site": "noword",
      "public": "noword-source",
      "ignore": [
        "**/.*"
      ],
      "redirects": [
        {
          "source": "/",
          "destination": "/app/",
          "type": 302
        }
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        }
      ]
    },
    {
      "site": "uzunyoloyunlari",
      "public": "portal/uzunyol",
      "ignore": [
        "**/.*"
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        }
      ]
    }
  ]
}
